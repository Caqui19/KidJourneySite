rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /usuarios/{uid} {
      allow get: if isOwner(uid);
      allow list, delete: if false;
      allow create: if isOwner(uid)
        && request.resource.data.perfil == 'cliente';
      allow update: if isOwner(uid)
        && (
          (
            resource.data.get('perfil', '') == ''
            && request.resource.data.perfil == 'cliente'
          )
          || (
            request.resource.data.get('perfil', '') == resource.data.get('perfil', '')
            && (
              resource.data.get('perfil', '') == 'cliente'
              || (
                resource.data.get('perfil', '') == 'parceiro'
                && request.resource.data.aprovado == resource.data.aprovado
              )
            )
          )
        );
    }
  }
}
